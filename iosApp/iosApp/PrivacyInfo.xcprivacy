<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Collected Data Types -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Device ID (used by both AdMob and Amplitude) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>DeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>Advertising</string> <!-- AdMob -->
                <string>Analytics</string>   <!-- Amplitude -->
            </array>
        </dict>

        <!-- Approximate Location (AdMob only) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>CoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>Advertising</string>
                <string>Analytics</string>
            </array>
        </dict>

        <!-- Usage Data (both SDKs use it for analytics and ad reporting) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>ProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>Advertising</string>
                <string>Analytics</string>
            </array>
        </dict>

        <!-- Diagnostics (Amplitude and SDK crash/performance reporting) -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>CrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>AppFunctionality</string>
                <string>Analytics</string>
            </array>
        </dict>
    </array>

    <!-- App performs user tracking (because of AdMob) -->
    <key>NSPrivacyTracking</key>
    <true/>

    <!-- Third-party tracking domains -->
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <!-- Google Ads / AdMob -->
        <string>googleads.g.doubleclick.net</string>
        <string>pagead2.googlesyndication.com</string>
        <string>adservice.google.com</string>
        <string>adservice.googleadservices.com</string>
        <!-- Amplitude -->
        <string>api.amplitude.com</string>
        <string>region1.amplitude.com</string>
        <string>analytics.amplitude.com</string>
    </array>
</dict>
</plist>
